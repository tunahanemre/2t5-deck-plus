{
  "templateId": "iterm2",
  "name": "iTerm2",
  "bundleId": "com.googlecode.iterm2",
  "summary": "Scroll the output, switch tabs, change the font size, split and move between panes. No close, no interrupt keys.",
  "notes": "",
  "preset": {
    "schema": 1,
    "id": "com.googlecode.iterm2",
    "name": "iTerm2",
    "packs": [
      "generic",
      "browser"
    ],
    "banks": {
      "base": {
        "D1": {
          "type": "scrollDelta",
          "linesPerDetent": 1,
          "detentThreshold": 1,
          "label": "Scroll"
        },
        "D2": {
          "action": "browser.tabs",
          "label": "Switch tab"
        },
        "Exposure": {
          "type": "keyDelta",
          "keyCW": "Cmd+=",
          "keyCCW": "Cmd+-",
          "detentThreshold": 1,
          "label": "Font size"
        },
        "C1": {
          "type": "key",
          "key": "Cmd+T",
          "label": "New tab"
        },
        "C2": {
          "type": "key",
          "key": "Cmd+0",
          "label": "Reset font size"
        },
        "C3": {
          "type": "key",
          "key": "Cmd+D",
          "label": "Split pane"
        },
        "C4": {
          "type": "key",
          "key": "Cmd+]",
          "label": "Next pane"
        },
        "C5": {
          "type": "key",
          "key": "Cmd+[",
          "label": "Previous pane"
        }
      }
    },
    "settings": {}
  }
}
